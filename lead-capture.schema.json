{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fernandafsoares.com.br/schemas/lead-capture.json",
  "title": "Contato consentido do site institucional",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "service", "privacy_consent", "consent_at", "source"],
  "properties": {
    "name": {"type": "string", "minLength": 2, "maxLength": 120},
    "company": {"type": "string", "maxLength": 180},
    "role": {"type": "string", "maxLength": 120},
    "service": {"type": "string", "maxLength": 120},
    "message": {"type": "string", "maxLength": 2000},
    "privacy_consent": {"const": true},
    "consent_at": {"type": "string", "format": "date-time"},
    "source": {"const": "institutional_site"},
    "page_url": {"type": "string", "format": "uri", "maxLength": 1000},
    "attribution": {
      "type": "object",
      "additionalProperties": {"type": "string", "maxLength": 500}
    }
  }
}
